{
  "name": "ivealready",
  "version": "0.1.0",
  "description": "I've Already - track everything you've watched, read, and played",
  "author": "Lucas Salomão Boschiroli",
  "license": "UNLICENSED",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.0",
    "dotenv": "^16.4.5",
    "electron-updater": "^6.3.9",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.ivealready.app",
    "productName": "I've Already",
    "directories": { "buildResources": "build", "output": "dist" },
    "files": ["src/**/*", "package.json", "!src/main/db.js", "!src/main/schema.sql"],
    "extraResources": [{ "from": ".env", "to": ".env" }],
    "win": { "target": "nsis", "icon": "build/icon.ico" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true },
    "publish": { "provider": "github", "owner": "lucasboschiroli", "repo": "IveAlready" }
  }
}
