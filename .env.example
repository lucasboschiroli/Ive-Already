# Get a free API key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Supabase project — Project Settings -> API in your Supabase dashboard
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_public_key_here

# Videogames — free key at https://rawg.io/apidocs
RAWG_API_KEY=your_rawg_api_key_here

# Optional: IMDb / Rotten Tomatoes scores — https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# Optional: Steam library import — https://steamcommunity.com/dev/apikey
# Never ship this in a public build (the .env is bundled into the installer).
STEAM_API_KEY=

# Optional: country for "where to watch" (two-letter code, default US)
TMDB_WATCH_REGION=
